[Unit]
Description=AD password self-service
Documentation=file:///opt/password-self-service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pss
Group=pss
WorkingDirectory=/opt/password-self-service
ExecStart=/opt/password-self-service/password-self-service --config /opt/password-self-service/etc/password-self-service.yaml
Restart=on-failure
RestartSec=3
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal
SyslogIdentifier=password-self-service

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/password-self-service/etc /opt/password-self-service/var

[Install]
WantedBy=multi-user.target
